    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0024",
      "start": 102.27,
      "end": 105.81,
      "text": "If I wanted to be uplifted, I might have a quote.",
      "avg_logprob": -0.187,
