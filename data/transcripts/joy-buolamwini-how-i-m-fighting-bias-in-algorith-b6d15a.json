      "start": 83.13,
      "end": 86.37,
      "text": "I'm a graduate student at the MIT Media Lab.",
      "avg_logprob": -0.12,
      "no_speech_prob": 0.015,
      "compression_ratio": 1.553
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0018",
      "start": 86.37,
      "end": 88.57,
      "text": "And there I have the opportunity",
      "avg_logprob": -0.12,
