      "start": 207.59,
      "end": 210.11,
      "text": "So how this works is you create a training set",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0056",
      "start": 210.11,
      "end": 211.39,
      "text": "with examples of faces.",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0057",
      "start": 211.39,
      "end": 214.35,
      "text": "This is a face, this is a face, this is not a face.",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0058",
      "start": 214.35,
      "end": 216.87,
      "text": "And over time, you can teach a computer",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0059",
      "start": 216.87,
      "end": 218.93,
      "text": "to recognize other faces.",
      "avg_logprob": -0.154,
      "no_speech_prob": 0.15,
      "compression_ratio": 1.533
    },
    {
