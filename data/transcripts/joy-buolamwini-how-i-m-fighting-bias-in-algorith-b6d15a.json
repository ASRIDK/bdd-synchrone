    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0021",
      "start": 94.61,
      "end": 98.45,
      "text": "so I could project digital masks onto my reflection.",
      "avg_logprob": -0.12,
      "no_speech_prob": 0.015,
