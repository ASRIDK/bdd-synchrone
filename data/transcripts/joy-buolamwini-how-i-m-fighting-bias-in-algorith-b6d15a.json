      "start": 79.25,
      "end": 83.13,
      "text": "Well, when I'm not fighting the coded gaze as a poet of code,",
      "avg_logprob": -0.12,
      "no_speech_prob": 0.015,
      "compression_ratio": 1.553
    },
    {
