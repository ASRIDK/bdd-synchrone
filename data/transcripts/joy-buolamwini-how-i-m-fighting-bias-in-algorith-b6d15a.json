      "no_speech_prob": 0.01,
      "compression_ratio": 1.505
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0013",
      "start": 68.65,
      "end": 71.01,
      "text": "So how did this happen?",
      "avg_logprob": -0.314,
      "no_speech_prob": 0.01,
