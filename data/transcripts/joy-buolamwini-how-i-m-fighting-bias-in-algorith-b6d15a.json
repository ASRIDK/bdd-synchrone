    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0025",
      "start": 105.83,
      "end": 110.25,
      "text": "So I used generic facial recognition software to build the system,",
      "avg_logprob": -0.187,
      "no_speech_prob": 0.051,
      "compression_ratio": 1.558
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0026",
      "start": 110.27,
      "end": 113.05,
      "text": "but found that it was really hard to test it,",
      "avg_logprob": -0.187,
      "no_speech_prob": 0.051,
      "compression_ratio": 1.558
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0027",
      "start": 113.07,
      "end": 115.27,
      "text": "unless if I wore a white mask.",
      "avg_logprob": -0.187,
      "no_speech_prob": 0.051,
      "compression_ratio": 1.558
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0028",
      "start": 116.33,
      "end": 120.67,
      "text": "Unfortunately, I've run into this issue before.",
      "avg_logprob": -0.187,
      "no_speech_prob": 0.051,
      "compression_ratio": 1.558
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0029",
      "start": 120.69,
      "end": 125.03,
      "text": "When I was an undergraduate at Georgia Tech studying computer science,",
      "avg_logprob": -0.187,
      "no_speech_prob": 0.051,
      "compression_ratio": 1.558
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0030",
      "start": 125.05,
      "end": 127.11,
      "text": "I used to work on social robots.",
      "avg_logprob": -0.187,
      "no_speech_prob": 0.051,
      "compression_ratio": 1.558
    },
    {
