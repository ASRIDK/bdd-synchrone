      "start": 40.42,
      "end": 46.58,
      "text": "Bias can also lead to exclusionary experiences and discriminatory practices.",
      "avg_logprob": -0.314,
      "no_speech_prob": 0.01,
      "compression_ratio": 1.505
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0005",
      "start": 46.58,
      "end": 48.18,
      "text": "Let me show you what I mean.",
