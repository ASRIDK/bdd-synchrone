    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0049",
      "start": 191.79,
      "end": 195.79,
      "text": "as it takes to download some files off of the internet.",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0050",
      "start": 195.79,
      "end": 196.75,
      "text": "So what's going on?",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0051",
      "start": 196.75,
      "end": 198.87,
      "text": "Why isn't my face being detected?",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0052",
      "start": 198.87,
      "end": 202.27,
      "text": "Well, we have to look at how we give machine sight.",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0053",
      "start": 202.27,
      "end": 205.71,
      "text": "Computer vision uses machine learning techniques",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0054",
      "start": 205.71,
      "end": 207.59,
      "text": "to do facial recognition.",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
      "compression_ratio": 1.665
    },
    {
