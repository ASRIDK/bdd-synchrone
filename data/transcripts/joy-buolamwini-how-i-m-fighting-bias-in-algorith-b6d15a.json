      "no_speech_prob": 0.008,
      "compression_ratio": 1.599
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0043",
      "start": 170.11,
      "end": 175.03,
      "text": "The demo worked on everybody until it got to me, and you can probably guess it.",
      "avg_logprob": -0.154,
      "no_speech_prob": 0.008,
      "compression_ratio": 1.599
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0044",
      "start": 175.07,
      "end": 178.03,
      "text": "It couldn't detect my face.",
      "avg_logprob": -0.154,
      "no_speech_prob": 0.008,
      "compression_ratio": 1.599
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0045",
      "start": 178.07,
      "end": 180.43,
      "text": "I asked the developers what was going on,",
      "avg_logprob": -0.154,
      "no_speech_prob": 0.008,
      "compression_ratio": 1.599
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0046",
      "start": 180.47,
      "end": 186.11,
      "text": "and it turned out we had used the same generic facial recognition software.",
      "avg_logprob": -0.154,
      "no_speech_prob": 0.008,
      "compression_ratio": 1.599
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0047",
      "start": 186.15,
      "end": 187.71,
      "text": "Halfway around the world,",
      "avg_logprob": -0.154,
      "no_speech_prob": 0.008,
      "compression_ratio": 1.599
    },
    {
      "id": "joy-buolamwini-how-i-m-fighting-bias-in-algorith-b6d15a#0048",
      "start": 187.71,
      "end": 191.79,
      "text": "that I learned that algorithmic bias can travel as quickly",
      "avg_logprob": -0.139,
      "no_speech_prob": 0.007,
