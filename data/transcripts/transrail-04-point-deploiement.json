      "id": "transrail-04-point-deploiement#0000",
      "start": 0.62,
      "end": 5.62,
      "text": "Bonjour à tous, on fait le point sur les mises en production de TransRai.",
      "avg_logprob": -0.11,
      "no_speech_prob": 0.026,
