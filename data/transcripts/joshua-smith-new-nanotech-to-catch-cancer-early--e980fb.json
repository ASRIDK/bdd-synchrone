    },
    {
      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--e980fb#0039",
      "start": 224.81,
      "end": 229.69,
      "text": "in our case included our two young daughters. Because we found it early",
      "avg_logprob": -0.212,
