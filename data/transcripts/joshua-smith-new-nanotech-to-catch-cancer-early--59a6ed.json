    },
    {
      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--59a6ed#0019",
      "start": 65.24,
      "end": 69.44,
      "text": "an early stage cancer alarm by enabling regular screenings",
      "avg_logprob": -0.16,
      "no_speech_prob": 0.006,
