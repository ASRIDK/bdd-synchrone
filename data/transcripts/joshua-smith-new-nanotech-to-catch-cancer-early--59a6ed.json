      "avg_logprob": -0.119,
      "no_speech_prob": 0.005,
      "compression_ratio": 1.62
    },
    {
      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--59a6ed#0011",
      "start": 42.88,
      "end": 46.24,
      "text": "or other liquid biopsy and present you with the results",
