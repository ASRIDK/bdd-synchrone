      "avg_logprob": -0.119,
      "no_speech_prob": 0.005,
      "compression_ratio": 1.62
    },
    {
      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--59a6ed#0015",
      "start": 53.72,
      "end": 57.0,
      "text": "of an early stage cancer diagnosis.",
      "avg_logprob": -0.16,
      "no_speech_prob": 0.006,
      "compression_ratio": 1.67
    },
    {
      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--59a6ed#0016",
      "start": 57.0,
      "end": 59.72,
      "text": "Now my research team of engineers and biochemists",
      "avg_logprob": -0.16,
      "no_speech_prob": 0.006,
      "compression_ratio": 1.67
    },
    {
      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--59a6ed#0017",
      "start": 59.72,
      "end": 62.4,
      "text": "is working on exactly this challenge.",
      "avg_logprob": -0.16,
      "no_speech_prob": 0.006,
      "compression_ratio": 1.67
    },
    {
      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--59a6ed#0018",
      "start": 62.4,
      "end": 65.24,
      "text": "We're working on ways to frequently activate",
