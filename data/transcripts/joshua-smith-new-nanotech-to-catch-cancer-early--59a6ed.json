    },
    {
      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--59a6ed#0020",
      "start": 69.44,
      "end": 71.88,
      "text": "that would start when a person is healthy,",
      "avg_logprob": -0.16,
      "no_speech_prob": 0.006,
