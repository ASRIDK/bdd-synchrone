      "id": "joshua-smith-new-nanotech-to-catch-cancer-early--59a6ed#0008",
      "start": 31.84,
      "end": 34.68,
      "text": "for many types of cancers much more accessible.",
      "avg_logprob": -0.119,
      "no_speech_prob": 0.005,
      "compression_ratio": 1.62
    },
